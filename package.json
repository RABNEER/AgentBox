{
  "name": "agentbox-mail",
  "version": "2.1.0",
  "description": "The Sovereign Email & Identity Layer for AI Agents (Claude Code, Cursor, Antigravity, OpenAI Swarm)",
  "main": "electron/main.js",
  "bin": {
    "agentbox": "bin/agentbox.js",
    "agentbox-mail": "bin/agentbox.js"
  },
  "files": [
    "bin/",
    "electron/",
    "skills/",
    "ui/",
    "interface.html",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/agentbox.js ui",
    "app": "electron electron/main.js",
    "desktop": "electron electron/main.js",
    "mcp": "node ./bin/agentbox.js mcp",
    "init": "node ./bin/agentbox.js init",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.agentbox.mail",
    "productName": "AgentBox Mail",
    "copyright": "Copyright © 2026 AgentBox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "skills/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/agentbox-mail.exe",
        "to": "bin/agentbox-mail.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentBox Mail"
    }
  },
  "keywords": [
    "ai",
    "agents",
    "mailbox",
    "otp",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "antigravity",
    "hostinger",
    "email-automation",
    "electron"
  ],
  "author": "ranveer.kr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RABNEER/AgentBox.git"
  },
  "bugs": {
    "url": "https://github.com/RABNEER/AgentBox/issues"
  },
  "homepage": "https://github.com/RABNEER/AgentBox#readme",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  }
}

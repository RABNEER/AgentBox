# AgentBox Configuration Example

# Domain & Primary Agent Mailbox
DOMAIN=local.agentbox
PRIMARY_AGENT_EMAIL=agent@local.agentbox
AGENT_NAME=agent

# Inbound & Dashboard Server Ports
SMTP_PORT=2525
HTTP_PORT=3000
DATABASE_URL=sqlite://agentbox.db?mode=rwc

# Upstream Mailbox Sync (Hostinger / Titan / Google Workspace / Stalwart / Custom IMAP)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=user@yourdomain.com
IMAP_PASS=your_secure_password_here

# Outbound SMTP Relay
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=user@yourdomain.com
SMTP_PASS=your_secure_password_here
